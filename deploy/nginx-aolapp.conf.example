# aolapp.ru — браузер / PWA
# vk.aolapp.ru — VK Mini App (тот же root)
#
# Размещение: /etc/nginx/sites-available/aolapp
#   sudo ln -s /etc/nginx/sites-available/aolapp /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# SSL после DNS vk.aolapp.ru:
#   sudo certbot --nginx -d aolapp.ru -d www.aolapp.ru -d vk.aolapp.ru

server {
    listen 80;
    listen [::]:80;
    server_name aolapp.ru www.aolapp.ru vk.aolapp.ru;

    # Certbot подменит на redirect → https
    root /var/www/meditation/current;
    index index.html;

    # VK iframe: не ставить X-Frame-Options DENY / CSP frame-ancestors 'none'
    add_header X-Content-Type-Options nosniff always;

    # HTML/SW shell — всегда перепроверять, иначе VK WebView/PWA живут на старом билде
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Медиа вне releases — переживает --delete деплоя
    location /media/ {
        alias /var/www/meditation/media/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Access-Control-Allow-Origin *;
    }

    # Analytics pixel: events → access log (goaccess / duckdb)
    # log_format events '$time_iso8601\t$arg_n\t$args\t$http_referer\t$http_user_agent';
    location = /e.gif {
        empty_gif;
        access_log /var/log/nginx/meditate-events.log;
        add_header Cache-Control "no-store";
        add_header Access-Control-Allow-Origin *;
    }

    location ~* \.(?:js|css|woff2|png|jpg|jpeg|webp|svg|ico)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
    }
}

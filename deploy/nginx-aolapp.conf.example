# aolapp.ru — браузер / PWA
# vk.aolapp.ru — VK Mini App (тот же root)
#
# Размещение: /etc/nginx/sites-available/aolapp
#   sudo ln -s /etc/nginx/sites-available/aolapp /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# SSL после DNS vk.aolapp.ru:
#   sudo certbot --nginx -d aolapp.ru -d www.aolapp.ru -d vk.aolapp.ru

server {
    listen 80;
    listen [::]:80;
    server_name aolapp.ru www.aolapp.ru vk.aolapp.ru;

    # Certbot подменит на redirect → https
    root /var/www/meditation/current;
    index index.html;

    # VK iframe: не ставить X-Frame-Options DENY / CSP frame-ancestors 'none'
    add_header X-Content-Type-Options nosniff always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Медиа вне releases — переживает --delete деплоя
    location /media/ {
        alias /var/www/meditation/media/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Access-Control-Allow-Origin *;
    }

    location ~* \.(?:js|css|woff2|png|jpg|jpeg|webp|svg|ico)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
    }
}

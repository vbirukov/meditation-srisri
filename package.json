{
  "name": "meditate-with-sri-sri",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=16.14"
  },
  "type": "module",
  "scripts": {
    "media:manifest": "node scripts/generate-media-manifest.mjs",
    "offline:manifest": "node scripts/generate-offline-manifest.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "posters:manifest": "npm run media:manifest",
    "dev": "npm run media:manifest && npm run offline:manifest && vite",
    "build": "npm run media:manifest && npm run offline:manifest && npm run pwa:icons && tsc --noEmit && vite build",
    "generate-media": "node scripts/generate-media.mjs",
    "optimize:textures": "node scripts/optimize-textures.mjs && npm run media:manifest",
    "optimize:audio": "node scripts/optimize-audio.mjs",
    "optimize:video": "node scripts/optimize-video.mjs",
    "add-practice": "node scripts/add-practice.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "notifier:check": "node scripts/notifier/notifier.mjs self-check",
    "check:streak": "node scripts/check-streak.mjs",
    "check:mood": "node scripts/check-mood.mjs",
    "check:add-practice": "node scripts/add-practice.mjs --self-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "start": "npm run build && npm run preview"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "~5.6.3",
    "vite": "^4.5.5",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
